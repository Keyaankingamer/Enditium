{
	"schemaVersion": 1,
	"id": "enditium",
	"version": "${version}",
	"name": "Enditium",
	"description": "Enditium is a mod that adds a unique take on Enderite/End Netherite/End ore, with a bit more of an advanced crafting tree then Netherite, including combinding many new materials exclusively found in the end.",
	"authors": [
		"Keyaan"
	],
	"contact": {
		"homepage": "keyaan.carrd.co"
	},
	"license": "CC0-1.0",
	"icon": "assets/enditium/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.keyaan.Enditium"
		],
		"client": [
			"com.keyaan.client.EnditiumClient"
		],
		"fabric-datagen": [
			"com.keyaan.client.EnditiumDataGenerator"
		]
	},
	"mixins": [
		"enditium.mixins.json",
		{
			"config": "enditium.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}